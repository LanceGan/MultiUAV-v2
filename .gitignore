# STC run-scoped experiment artifacts (frozen separately, not tracked)
results/runs/
results/models/
results/figs/

# failed/timeout run quarantine (preserved evidence, outside Gate 4 scan scope)
results/runs_failed/
results/runs_pilot/
results/figs_pilot/
results/runs_probe/
